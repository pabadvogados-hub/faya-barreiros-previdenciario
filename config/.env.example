# Copie para config/.env (NUNCA versionar) e preencha. So ha aqui variavel que o codigo le de fato.
# Valor com $ (a chave do Asaas comeca com $aact_): use ASPAS SIMPLES, senao o python-dotenv
# pode tentar interpretar o $ como variavel.

# --- Asaas (financeiro/*) — Integracoes > Chave de API da conta do escritorio
ASAAS_API_KEY=''
# producao: https://api.asaas.com/v3   |   homologacao: https://api-sandbox.asaas.com/v3
ASAAS_BASE_URL=https://api.asaas.com/v3

# --- Notion (controladoria, documentos, financeiro: tarefas; atendimento: leitura)
# Token de uma "integracao interna" (https://www.notion.so/my-integrations). Cada base (Processos,
# Prazos/Tarefas, Clientes) precisa ser compartilhada com a integracao em "... > Conexoes".
# Ids das bases e nomes das colunas: config/escritorio.json -> notion.
NOTION_TOKEN=

# --- OneDrive/SharePoint: pasta LOCAL sincronizada (sem API da Microsoft)
# Windows: C:\Users\<usuario>\OneDrive - Faya Barreiros\ESCRITORIO
# VPS:     /mnt/onedrive/ESCRITORIO   (montada pelo rclone; ver automacoes/README.md)
ONEDRIVE_RAIZ=

# --- Tramitacao Inteligente: ainda sem integracao (API nao documentada para nos).
# Quando houver, a credencial entra aqui (ex.: TRAMITACAO_API_TOKEN=). Hoje o codigo nao le nada.

# --- Backup semanal (backup/backup_semanal.py)
BACKUP_DIR=/opt/escritorio/backups
BACKUP_MANTER=8
# arquivo com a senha da cifra (chmod 600); guardar uma copia FORA da VPS
BACKUP_SENHA_ARQUIVO=/opt/escritorio/config/backup.senha

# --- Pastas (opcional): onde ficam banco, filas e relatorios. Padrao: <pasta do projeto>/dados
ESCRITORIO_DADOS_DIR=
# Teste: simula a data de hoje (AAAA-MM-DD). Deixe vazio em producao.
ESCRITORIO_HOJE=

# --- Painel das demandas externas de calculo (automacoes/painel/servidor.py)
# Usuario e senha do painel (tem dado de cliente: senha forte, nunca a padrao)
PAINEL_USUARIO=faya
PAINEL_SENHA=
# Token do link que vai para os advogados parceiros (/pedido?t=TOKEN). Gerar: python -c "import secrets;print(secrets.token_urlsafe(18))"
PAINEL_TOKEN_PEDIDO=
PAINEL_HOST=127.0.0.1
PAINEL_PORTA=8765
# 1 = cada pedido do parceiro vira tarefa [CALCULO EXTERNO] no Notion (exige o Notion configurado)
PAINEL_TAREFA_NOTION=0
# 1 = o botao "Cobrar no Asaas" emite de verdade (senao so simula)
PAINEL_PERMITE_COBRANCA=0
